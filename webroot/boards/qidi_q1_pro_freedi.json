  "note": "Dedicated Q1 Pro profile. Compiles two separate MCU images: qd_mcu.bin for the STM32F402-marked mainboard using Klipper STM32F401XC support, and Toolhead_Q1_klipper.bin for the RP2040 toolhead. X/Y use TMC2240; Z/Z1/extruder use TMC2209. Keep a stock configuration backup and verify revision-specific currents before flashing.",
  "mcu_selector_label": "Q1 Pro hardware / mainboard build target",
  "mcu_variants": [
    {
      "id": "QIDI_STM32F402_F401XC",
      "label": "STM32F402-marked mainboard (Klipper STM32F401XC target) + RP2040 toolhead",
      "klipper_mcu": "stm32f401xc",
      "klipper_mach": "CONFIG_MACH_STM32F401",
      "hardware_mcu": "QIDI STM32F402-marked mainboard",
      "build_target": "STM32F401XC"
    }
  ],
