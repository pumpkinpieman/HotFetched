        "uart_pin": "PC5",
        "run_current": "0.6"
      },
      "tmc2209 stepper_z1": {
        "uart_pin": "PB7",
        "run_current": "0.6"
      },
      "tmc2209 extruder": {
        "uart_pin": "Toolhead:gpio6",
        "run_current": "0.714",
        "sense_resistor": "0.075"
      }
    },
